# Copy to local.env (git-ignored). quicktest.sh sources it; for a real deployment export the same variables
# to the services (for example with a systemd EnvironmentFile=).
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# ---- required (services refuse to start if missing, shorter than 8 chars, or a known default) ----
PUBLIC_HOST=ctf.example.org              # spawner refuses to start without it
SPAWNER_ADMIN_KEY=CHANGE_ME_long_random  # admin API of the spawner (port 9000, localhost only)
DASHBOARD_ADMIN_KEY=CHANGE_ME_long_random # admin API of the scoreboard (backup / reset)
INGEST_SECRET=CHANGE_ME_long_random      # master secret for per-team ingest tokens (never leaves the host)
EVENT_PASSWORD=CHANGE_ME_long_random     # password teams must enter at the gate

# ---- strongly recommended ----
SPAWNER_FLAG_SECRET_SALT=CHANGE_ME_long_random   # keeps per-team flag values stable across spawner restarts

# ---- optional (defaults shown) ----
#ADMIN_OPEN_BASE=https://ctf.example.org   # base URL used by the admin console's "open" links (no default)
#CTF_IMAGE=ngdsa-llm-ctf:latest
#CONTAINER_PORT=8001
#PORT_MIN=20000
#PORT_MAX=20099
#BIND_HOST=0.0.0.0
#MAX_AGE_MINUTES=240                       # team containers are removed after this long
#KEYS_FILE=./api_keys.txt
#POOL_DEFAULT_PROVIDER=groq                # groq | cerebras | gemini
#DASHBOARD_INGEST_URL=http://localhost:8000/api/ingest   # default; must be reachable from the team containers (e.g. http://host.docker.internal:8000/api/ingest)
#DASHBOARD_REGISTER_URL=http://127.0.0.1:8000/api/register          # as seen from the spawner
#DASHBOARD_BASE=http://127.0.0.1:8000
#DASHBOARD_DB_PATH=./ctf_dashboard.db
#DASHBOARD_BACKUP_DIR=./backups
#SHOW_EVENT_PASSWORD=0                     # 1 = show the gate password on the public scoreboard
#JOIN_URL=ctf.example.org                  # shown next to the password on the scoreboard
